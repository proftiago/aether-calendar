# Copie este arquivo para .env.local (não versionado) pra rodar localmente
# com sync real do Google Calendar. Sem essas variáveis, o app continua
# funcionando normalmente, só que o botão "Conectar Google Calendar"
# volta a usar a simulação (eventos mock) em vez do Google de verdade.

# URL base das Edge Functions do seu projeto Supabase
# (Project Settings > Data API > URL, trocando /rest/v1 por /functions/v1)
VITE_SUPABASE_FUNCTIONS_URL=https://SEU-PROJETO.supabase.co/functions/v1

# A MESMA chave que você configurou como AETHER_API_KEY nas secrets da
# Edge Function google-calendar (é uma chave que você mesmo inventa —
# gere uma com: openssl rand -hex 32)
VITE_AETHER_API_KEY=

# Client ID do OAuth do Google Cloud Console (não é secreto, pode ir no frontend)
VITE_GOOGLE_CLIENT_ID=

# anon key do projeto Supabase (Project Settings > API > Project API keys >
# anon/public) — usada só pra sincronizar tarefas/configurações entre
# dispositivos (tabela aether_sync_data, ver supabase/migrations/
# 0002_device_sync.sql). Sem essa variável, a sincronização entre
# dispositivos fica desativada, mas o resto do app funciona normal.
VITE_SUPABASE_ANON_KEY=
